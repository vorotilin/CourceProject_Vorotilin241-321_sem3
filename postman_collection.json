              "path": ["api", "projects", "search_complex", ""],
              "query": [{"key": "q", "value": "Django"}]
            }
          }
        },
        {
          "name": "Добавить навык к проекту",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",       "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skill_id\": {{skill_id}}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/projects/{{project_id}}/add_skill/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{project_id}}", "add_skill", ""]
            }
          }
        },
        {
          "name": "Удалить навык у проекта",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept",       "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skill_id\": {{skill_id}}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/projects/{{project_id}}/remove_skill/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{project_id}}", "remove_skill", ""]

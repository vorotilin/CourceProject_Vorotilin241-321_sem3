{
  "info": {
    "_postman_id": "portfolio-students-api-v1",
    "name": "Портфолио студентов — API",
    "description": "REST API курсового проекта «Портфолио студентов». Группа 241-321, семестр 4.\n\nАутентификация: Basic Auth (username + password). Задать значения в переменных коллекции.\n\nBase URL: http://127.0.0.1:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {"key": "username", "value": "{{username}}", "type": "string"},
      {"key": "password", "value": "{{password}}", "type": "string"}
    ]
  },
  "variable": [
    {"key": "base_url",     "value": "http://127.0.0.1:8000", "type": "string"},
    {"key": "username",     "value": "admin",                  "type": "string"},
    {"key": "password",     "value": "admin",                  "type": "string"},
    {"key": "project_id",   "value": "1",                      "type": "string"},
    {"key": "event_id",     "value": "1",                      "type": "string"},
    {"key": "user_id",      "value": "1",                      "type": "string"},
    {"key": "category_id",  "value": "1",                      "type": "string"},
    {"key": "skill_id",     "value": "1",                      "type": "string"},
    {"key": "event_type_id","value": "1",                      "type": "string"}
  ],
  "item": [
    {
      "name": "Пользователи",
      "item": [
        {
          "name": "Список пользователей",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/users/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ""]
            }
          }
        },
        {
          "name": "Пользователь по ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", ""]
            }
          }
        },
        {
          "name": "Поиск пользователей",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/users/?search=Илья",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ""],
              "query": [{"key": "search", "value": "Илья"}]
            }
          }
        },
        {
          "name": "Пользователи по убыванию проектов",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/api/users/?ordering=-projects_count",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ""],
              "query": [{"key": "ordering", "value": "-projects_count"}]
            }
          }
        }
      ]
    },
    {

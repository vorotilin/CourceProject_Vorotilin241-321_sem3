              "mode": "raw",
              "raw": "{\n  \"title\": \"Мой новый проект\",\n  \"description\": \"Описание проекта\",\n  \"category_id\": 1,\n  \"skill_ids\": [1, 2]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/api/projects/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", ""]
            }
